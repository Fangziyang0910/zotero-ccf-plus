{
  "name": "zotero-ccf-plus",
  "version": "0.3.4",
  "description": "Zotero Plugin for easily obtaining the CCF rating, corresponding conference/journal, and citation count of a paper using a cascading Semantic Scholar + DBLP engine.",
  "config": {
    "addonName": "Zotero CCF Plus",
    "addonID": "ccfplus@timetrapzz.site",
    "addonRef": "ccfplus",
    "addonInstance": "CCFPlus",
    "prefsPrefix": "extensions.zotero.ccfplus"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fangziyang0910/zotero-ccf-plus.git"
  },
  "author": "Fangziyang0910",
  "bugs": {
    "url": "https://github.com/Fangziyang0910/zotero-ccf-plus/issues"
  },
  "homepage": "https://github.com/Fangziyang0910/zotero-ccf-plus#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "tsc --noEmit && zotero-plugin build",
    "lint": "eslint .",
    "release": "zotero-plugin release",
    "test": "node --test tests/*.test.mjs",
    "update-deps": "npm update --save",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check src addon tests package.json README.md CHANGELOG.md CONTRIBUTING.md .github/workflows",
    "format": "prettier --write src addon tests package.json README.md CHANGELOG.md CONTRIBUTING.md .github/workflows",
    "check": "npm test && npm run lint && npm run format:check"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "5.1.0-beta.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.0.10",
    "eslint": "^10.8.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.1",
    "zotero-plugin-scaffold": "^0.8.2",
    "zotero-types": "4.1.0-beta.4",
    "esbuild": "0.28.0"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  },
  "engines": {
    "node": ">=22"
  }
}
